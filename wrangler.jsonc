{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "times-table-adventures",
  "compatibility_date": "2026-09-16",
  // Cloudflare Workers (static assets): the Worker runs first to inject
  // security headers, then falls through to dist/ with SPA handling.
  // NOTE: do not add pages_build_output_dir here - wrangler would treat the
  // project as Pages and reject `wrangler deploy` on Workers Builds.
  "main": "workers/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "STATIC_ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  // Standard route (not custom_domain): the hostname's DNS record stays as-is
  // and this route intercepts requests at the edge before they reach the old
  // origin. To fully detach later, delete the DNS record and switch this to
  // { "pattern": "ttf.antoniosmith.xyz", "custom_domain": true }.
  "routes": [{ "pattern": "ttf.antoniosmith.xyz/*", "zone_name": "antoniosmith.xyz" }],
}
